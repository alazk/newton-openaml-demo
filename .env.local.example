# Copy to .env.local and fill in. On Vercel, set these under
# Settings -> Environment Variables instead, then redeploy.

# https://dashboard.newton.xyz -> API Keys. Server-side only. Its account's
# wallet must OWN the clients in the deploy record on-chain, or the gateway refuses tasks.
NEWTON_API_KEY=

# Client addresses are not set here. The site reads them from the committed
# deploy record, policy/out/clients.sepolia.json.

# Optional. Keyless public default if unset.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# NEWTON_GATEWAY_URL=https://gateway.testnet.newton.xyz/rpc
