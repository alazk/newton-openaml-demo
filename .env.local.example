# Copy to .env.local and fill in. On Vercel, set these under
# Settings -> Environment Variables instead, then redeploy.

# https://dashboard.newton.xyz -> API Keys. Server-side only. Its account's
# wallet must OWN both clients below on-chain, or the gateway refuses tasks.
NEWTON_API_KEY=

# The two OpenAMLDemoClient contracts (scripts/deploy-clients.mjs prints them;
# they are also in policy/out/clients.sepolia.json).
# Block: denies Sanctioned, Blocked, Fraud. Review: denies Flagged.
POLICY_CLIENT_BLOCK=
POLICY_CLIENT_REVIEW=

# Optional. Keyless public default if unset.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# NEWTON_GATEWAY_URL=https://gateway.testnet.newton.xyz/rpc
